{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/teachers/:id",
      "destination": "/api/teachers?id=:id"
    },
    {
      "source": "/api/classes/:id",
      "destination": "/api/classes?id=:id"
    },
    {
      "source": "/api/submissions/:id",
      "destination": "/api/submissions?id=:id"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
